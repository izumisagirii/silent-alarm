# ── SilentAlarm R8 / ProGuard Keep Rules ──────────────────────────────
# Manifest-registered components (Activity / Service / Receiver / Provider)
# are kept automatically by AGP's generated aapt_rules.txt, so they are not
# re-listed here.

# Shizuku UserService — instantiated reflectively by Shizuku via ComponentName,
# so its class name and members must survive obfuscation.
-keep class com.electrowiz.silentalarm.daemon.ShellService { *; }

# Shizuku client API crosses a Binder boundary and relies on internal
# reflection/AIDL dispatch; keep it intact to avoid cross-process breakage.
-keep class rikka.shizuku.** { *; }

# Generic Kotlin / Android keep attributes.
-keepattributes *Annotation*
-keepattributes Signature
-keepattributes InnerClasses
