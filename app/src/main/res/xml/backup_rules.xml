<?xml version="1.0" encoding="utf-8"?>
<!-- Alarm schedules reveal routines; never roam them to the cloud.
     Preferences DataStore lives under files/datastore/. -->
<full-backup-content>
    <exclude domain="file" path="datastore/alarm_settings.preferences_pb" />
    <exclude domain="file" path="logs/" />
</full-backup-content>
